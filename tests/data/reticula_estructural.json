{
  "parametrico": 1,
  "description": "Structural grid: columns at the crossing of axes and floors; beams joining their heads along one axis or the other.",
  "nodes": {
    "span in X": {"type": "Number", "value": 6},
    "span in Y": {"type": "Number", "value": 5},
    "floor height": {"type": "Number", "value": 3.5},
    "X axes": {"type": "Series", "count": 5, "level": "axis X"},
    "Y axes": {"type": "Series", "count": 4, "level": "axis Y"},
    "floors": {"type": "Series", "count": 6, "level": "floor"},
    "axes x": {"type": "Formula", "formula": "a * b", "a": {"node": "X axes"}, "b": {"node": "span in X"}},
    "axes y": {"type": "Formula", "formula": "a * b", "a": {"node": "Y axes"}, "b": {"node": "span in Y"}},
    "floor z": {"type": "Formula", "formula": "a * b", "a": {"node": "floors"}, "b": {"node": "floor height"}},
    "column centre": {"type": "Formula", "formula": "(a + 0,5) * b", "a": {"node": "floors"}, "b": {"node": "floor height"}},
    "beam z": {"type": "Formula", "formula": "(a + 1) * b", "a": {"node": "floors"}, "b": {"node": "floor height"}},
    "column section": {"type": "Number", "value": 0.4},
    "column": {"type": "Box", "width": {"node": "column section"}, "depth": {"node": "column section"}, "height": {"node": "floor height"}},
    "column centres": {"type": "Point", "x": {"node": "axes x"}, "y": {"node": "axes y"}, "z": {"node": "column centre"}},
    "pillars": {"type": "Place", "geometry": {"node": "column"}, "at": {"node": "column centres"}},
    "heads": {"type": "Point", "x": {"node": "axes x"}, "y": {"node": "axes y"}, "z": {"node": "beam z"}},
    "beam depth": {"type": "Number", "value": 0.5},
    "less depth": {"type": "Formula", "formula": "-a", "a": {"node": "beam depth"}},
    "downwards": {"type": "Point", "z": {"node": "less depth"}},
    "X beam lines": {"type": "Curve through points", "points": {"node": "heads"}, "along": "axis X", "smooth": false},
    "X beams face": {"type": "Extrude", "curve": {"node": "X beam lines"}, "vector": {"node": "downwards"}},
    "beams in X": {"type": "Thicken", "rectangle": {"node": "X beams face"}, "thickness": 0.3},
    "Y beam lines": {"type": "Curve through points", "points": {"node": "heads"}, "along": "axis Y", "smooth": false},
    "Y beams face": {"type": "Extrude", "curve": {"node": "Y beam lines"}, "vector": {"node": "downwards"}},
    "beams in Y": {"type": "Thicken", "rectangle": {"node": "Y beams face"}, "thickness": 0.3},
    "how many X axes": {"type": "Summarise", "data": {"node": "X axes"}, "operation": "tally"},
    "building width": {"type": "Formula", "formula": "(a - 1) * b", "a": {"node": "how many X axes"}, "b": {"node": "span in X"}},
    "how many Y axes": {"type": "Summarise", "data": {"node": "Y axes"}, "operation": "tally"},
    "building depth": {"type": "Formula", "formula": "(a - 1) * b", "a": {"node": "how many Y axes"}, "b": {"node": "span in Y"}},
    "at each floor": {"type": "Point", "z": {"node": "beam z"}},
    "plan": {"type": "Rectangle", "width": {"node": "building width"}, "height": {"node": "building depth"}, "origin": {"node": "at each floor"}},
    "slabs": {"type": "Thicken", "rectangle": {"node": "plan"}, "thickness": -0.2}
  },
  "export": ["pillars", "beams in X", "beams in Y", "slabs"],
  "controls": [
    {"value": "X axes.count", "min": 2, "max": 12, "step": 1, "label": "X axes"},
    {"value": "Y axes.count", "min": 2, "max": 12, "step": 1, "label": "Y axes"},
    {"value": "floors.count", "min": 1, "max": 30, "step": 1, "label": "floors"},
    {"value": "span in X.value", "min": 3, "max": 12, "step": 0.5, "unit": "m", "label": "span in X"},
    {"value": "span in Y.value", "min": 3, "max": 12, "step": 0.5, "unit": "m", "label": "span in Y"},
    {"value": "floor height.value", "min": 2.5, "max": 6, "step": 0.1, "unit": "m", "label": "floor height"},
    {"value": "column section.value", "min": 0.2, "max": 1, "step": 0.05, "unit": "m", "label": "column section"},
    {"value": "beam depth.value", "min": 0.2, "max": 1.2, "step": 0.05, "unit": "m", "label": "beam depth"}
  ],
  "view": {
    "pillars": {"color": "#8c939b"},
    "beams in X": {"color": "#b07a4f"},
    "beams in Y": {"color": "#b07a4f"},
    "slabs": {"color": "#d6d6d6", "opacity": 0.35}
  }
}
